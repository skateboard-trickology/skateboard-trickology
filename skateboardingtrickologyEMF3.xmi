  <packagedElement xmi:type="uml:Class" xmi:id="_ypXz6oYmEfG7lISgwFsiWA" name="HandplantTrick">
    <ownedComment xmi:id="_ypXz64YmEfG7lISgwFsiWA">
      <body>&lt;Enter note text here></body>
    </ownedComment>
    <generalization xmi:id="_ypXz7IYmEfG7lISgwFsiWA" general="_ypXzI4YmEfG7lISgwFsiWA"/>
    <ownedAttribute xmi:id="_ypXz7YYmEfG7lISgwFsiWA" name="typeOfHandplant" visibility="public" type="_ypXz7oYmEfG7lISgwFsiWA" isUnique="false"/>
